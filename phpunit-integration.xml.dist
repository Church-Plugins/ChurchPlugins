<?xml version="1.0" encoding="UTF-8"?>
<!--
	Integration suite: boots a real WordPress site with Church Plugins products
	active (see tests/Integration/bootstrap.php). Not part of the default run.

	CP_FW_WP_LOAD=/path/to/wp-load.php CP_FW_WP_URL=http://site.test/sub/ \
		php tests/vendor/bin/phpunit -c phpunit-integration.xml.dist
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="tests/vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/Integration/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	cacheResult="false">
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/Integration</directory>
		</testsuite>
	</testsuites>
</phpunit>

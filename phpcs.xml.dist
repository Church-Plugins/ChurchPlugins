<?xml version="1.0"?>
<ruleset name="ChurchPlugins">
	<description>Lint for request-action changes. Security and PHP compatibility sniffs on the admin request handler.</description>

	<file>Admin/_Init.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/CMB2/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
</ruleset>
